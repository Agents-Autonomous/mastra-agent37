# Agent37 integration tests and examples
# Copy to .env and fill in your credentials. Never commit .env.

# Workspace API key from https://www.agent37.com/dashboard/cloud/api-keys
AGENT37_API_KEY=sk_live_your_key

# Optional: model provider key for the agent examples (any Mastra model router provider works)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
