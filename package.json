{
  "name": "@mastra/agent37",
  "version": "0.1.0",
  "description": "Agent37 Cloud sandbox provider for Mastra workspaces, with computer use on a full Linux desktop",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:watch": "vitest watch",
    "test": "vitest run ./src/**/*.integration.test.ts",
    "test:cloud": "pnpm test",
    "lint": "oxlint --deny-warnings src examples",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sweep:test-instances": "tsx scripts/sweep-test-instances.ts",
    "example": "tsx",
    "example:in-agent37": "tsx scripts/run-example-in-agent37.ts"
  },
  "keywords": [
    "mastra",
    "agent37",
    "sandbox",
    "workspace",
    "computer-use",
    "ai-agents"
  ],
  "license": "Apache-2.0",
  "peerDependencies": {
    "@mastra/core": ">=1.83.0 <2.0.0-0"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "3.0.83",
    "@mastra/core": "1.83.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "dotenv": "^18.0.10",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "tsdown": "0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "5.1.0",
    "zod": "^4.6.7"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "packageManager": "pnpm@12.11.2"
}
