{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true,
    "declarationMap": true,
    "module": "Preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "paths": {
      "@mastra/agent37": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*", "examples/**/*", "scripts/**/*", "tsdown.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
